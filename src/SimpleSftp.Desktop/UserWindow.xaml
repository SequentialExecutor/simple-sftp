<Window x:Class="SimpleSftp.Desktop.UserWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="Add user" Width="560" Height="820" MinHeight="560" MinWidth="480" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <Grid Background="{StaticResource Surface}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Padding="28,26,28,22" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"><StackPanel>
   <TextBlock x:Name="Heading" Text="Add a user" FontSize="24" FontWeight="SemiBold"/>
   <TextBlock Text="Give someone secure access to a folder." Style="{StaticResource Secondary}" Margin="0,8,0,0"/>
  </StackPanel></Border>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="28,4,28,12">
   <TextBlock Text="Username" Style="{StaticResource Label}"/><TextBox x:Name="UsernameInput" AutomationProperties.Name="Username" MaxLength="64"/>
   <CheckBox x:Name="PasswordAuthenticationInput" Content="Allow password authentication" IsChecked="True" Checked="PasswordAuthentication_Changed" Unchecked="PasswordAuthentication_Changed" Margin="0,18,0,0"/>
   <TextBlock x:Name="PasswordLabel" Text="Password" Style="{StaticResource Label}"/><PasswordBox x:Name="PasswordInput" AutomationProperties.Name="Password" MaxLength="1024"/>
   <TextBlock Text="Use at least 12 characters." Style="{StaticResource Secondary}" Margin="0,6,0,0"/>
   <DockPanel Margin="0,18,0,8"><Button Content="Import .pub" DockPanel.Dock="Right" Click="ImportPublicKey_Click" MinHeight="30" Padding="10,5"/><TextBlock Text="Authorized public keys" Style="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/></DockPanel>
   <TextBox x:Name="AuthorizedKeysInput" TextWrapping="Wrap" AcceptsReturn="True" Height="104" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" MaxLength="262144" AutomationProperties.Name="Authorized public keys"/>
   <TextBlock Text="One OpenSSH public key per line. ECDSA and RSA are supported. Disable passwords for key-only access. Never paste private keys." Style="{StaticResource Secondary}" Margin="0,6,0,0"/>
   <TextBlock Text="Home folder" Style="{StaticResource Label}"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBox x:Name="FolderInput" AutomationProperties.Name="Home folder"/>
    <Button Content="Browse&#x2026;" Grid.Column="1" Click="Browse_Click" Margin="8,0,0,0"/>
   </Grid>
   <TextBlock Text="This folder appears as / when the user connects." Style="{StaticResource Secondary}" Margin="0,6,0,18"/>
   <Border Background="#F8F9FB" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="16,8"><StackPanel>
    <CheckBox x:Name="ReadOnlyInput" Content="Read-only access" AutomationProperties.Name="Read-only access"/>
    <TextBlock Text="Allow downloads and prevent file changes." Style="{StaticResource Secondary}" Margin="32,0,0,8"/>
    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,4,0,4"/>
    <CheckBox x:Name="EnabledInput" Content="Account enabled" IsChecked="True"/>
   </StackPanel></Border>
   <TextBlock x:Name="ErrorText" Foreground="#A52B38" FontSize="12" Margin="0,12,0,0" AutomationProperties.LiveSetting="Assertive"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Style.Triggers><DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
  </StackPanel></ScrollViewer>
  <Border Grid.Row="2" Padding="28,18" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Background="#FAFBFC">
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" IsCancel="True" Margin="0,0,8,0"/><Button x:Name="SaveButton" Content="Save user" Style="{StaticResource Primary}" IsDefault="True" Click="Save_Click"/></StackPanel>
  </Border>
 </Grid>
</Window>
